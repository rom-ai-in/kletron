# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_MODEL=gpt-5-mini
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# LM Studio (local OpenAI-compatible server)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=your-local-model-name
LMSTUDIO_API_KEY=lm-studio

# Optional: Choose default provider ("azure" or "lmstudio")
LLM_DEFAULT_PROVIDER=azure

LANGGRAPH_API_KEY=your_langgraph_api_key_here

# MCP tooling
MCP_URL=http://localhost:9000/sse

# MCP server → Web API bridge (must match between apps/mcp-server and apps/web)
MCP_INTERNAL_TOKEN=change-me-long-random-token

# Base URL of the Next.js web app (used by apps/mcp-server to resolve workspace capabilities)
KLETRON_WEB_BASE_URL=http://127.0.0.1:3000

# Canonical public URL of the Next.js app (no trailing slash). Required in production for
# Stripe redirects, NEXT_PUBLIC_* features, and must match Google OAuth settings below.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth root URL — in production set to the same https origin as NEXT_PUBLIC_APP_URL.
NEXTAUTH_URL=http://localhost:3000

# AES-256-GCM key for encrypting connector credentials at rest (32-byte hex or base64).
# Falls back to hashing NEXTAUTH_SECRET when unset (dev only — set explicitly in prod).
KLETRON_ENCRYPTION_KEY=

# Connector OAuth (examples — enable only what you need)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application):
#
# Authorized JavaScript origins (examples):
#   http://localhost:3000
#   https://YOUR_PUBLIC_ORIGIN
#
# Authorized redirect URIs — must match exactly (replace YOUR_PUBLIC_ORIGIN):
#   https://YOUR_PUBLIC_ORIGIN/api/auth/connect/google-drive/callback
#   https://YOUR_PUBLIC_ORIGIN/api/auth/connect/gmail/callback
#   https://YOUR_PUBLIC_ORIGIN/api/auth/connect/google-calendar/callback
#
# Local dev redirect URIs:
#   http://localhost:3000/api/auth/connect/google-drive/callback
#   http://localhost:3000/api/auth/connect/gmail/callback
#   http://localhost:3000/api/auth/connect/google-calendar/callback
#
# YOUR_PUBLIC_ORIGIN is the same value as NEXT_PUBLIC_APP_URL (scheme + host + optional port).

# Optional (reserved for later): Web search
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Override LangGraph recursion limit (default 50)
GRAPH_RECURSION_LIMIT=50

# Optional: Evict large tool outputs to .kletron/agent-cache (chars)
TOOL_RESULT_EVICT_CHARS=80000
# Optional: Preview chars to keep inline when evicted
TOOL_RESULT_PREVIEW_CHARS=2000

# Optional: GitHub repo selector (UI)
# Used to list your repos and clone private repositories.
GITHUB_TOKEN=your_github_token_here
# Optional: Where GitHub repos are cloned when selected in the UI
KLETRON_REPOS_DIR=/Users/you/Projects/kletron-repos

# MongoDB Configuration (for LLM config persistence)
MONGODB_URI=mongodb://localhost:27017/kletron
# Optional: MongoDB authentication
# MONGODB_USER=your_mongodb_user
# MONGODB_PASS=your_mongodb_password

# NextAuth Configuration
NEXTAUTH_SECRET=change-this-to-a-random-secret

# CORS Allowlist for /api/* (comma-separated origins, or '*' for any)
# Defaults to localhost dev ports when NODE_ENV !== "production"
KLETRON_CORS_ALLOWLIST=
