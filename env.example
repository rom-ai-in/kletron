# =============================================================================
# Kletron — environment template
# =============================================================================
# Quick path:
#   cp env.example .env
# Local OAuth / localhost UI only: also `cp env.local.example .env.local` (root) and/or
#   `cp apps/web/.env.local.example apps/web/.env.local` — see google OAuth comments below.
#   Fill **MINIMUM TO START** (Mongo + one LLM path + secrets below)
#   docker compose up -d mongo
#   npm install && npm run seed:demo && npm run dev
#
# Docs: README.md, CONTRIBUTING.md, ARCHITECTURE.md
# =============================================================================

# -----------------------------------------------------------------------------
# MINIMUM TO START (local dev)
# -----------------------------------------------------------------------------

# MongoDB — use docker compose (see docker-compose.yml) or your own instance
MONGODB_URI=mongodb://localhost:27017/kletron

# NextAuth — required for the web app (generate a long random string)
NEXTAUTH_SECRET=change-this-to-a-long-random-secret-for-local-dev

# Public origin of the web app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# GCP prod (custom domain + load balancer): set both to https://www.kletron.com then run
#   python3 infra/gcp/provision_secrets.py
# so Cloud Run gets NEXT_PUBLIC_APP_URL / NEXTAUTH_URL / CORS. Managed SSL can stay
# PROVISIONING ~15–60 min after DNS → https:// until then use the *.run.app URL.

# Trust X-Forwarded-* behind reverse proxies (Cloud Run, nginx, etc.)
AUTH_TRUST_HOST=true

# Hosted web (Cloud Run, etc.): workspace rootPath values often point at developer laptops
# (/Users/...). Those folders do not exist on the server — APIs would return 422 WORKSPACE_PATH_MISSING.
# Set true only when you accept chat/API without repo-backed tools on this host, or you mirror repos
# into paths that exist in the container separately.
# WORKSPACE_SKIP_LOCAL_FS_VALIDATION=true

# Optional — hosted Kletron + fichiers sur votre machine : slug du connecteur MCP externe (UI) qui
# pointe vers votre MCP local (ex. ngrok → http://127.0.0.1:9000/sse). Doit matcher exactement le
# slug du connecteur workspace. Les outils repo (list_files, read_file, git_*, …) sont alors
# routés vers `<slug>__<tool>` au lieu du MCP bundled Cloud Run. Voir docs/workspace-local-files-hosted-kletron.md
# KLETRON_REMOTE_FILE_MCP_SLUG=desktop

# --- Pick ONE default LLM path for agents (BYOK / local) ----------------------

# Option A — Local LM Studio / Ollama (recommended for $0 quickstart)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=your-local-model-name
LMSTUDIO_API_KEY=lm-studio
LLM_DEFAULT_PROVIDER=lmstudio

# Option B — Azure OpenAI (uncomment and fill; set LLM_DEFAULT_PROVIDER=azure)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# AZURE_OPENAI_MODEL=gpt-5-mini
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# LLM_DEFAULT_PROVIDER=azure

# Option C — Google Gemini (AI Studio API key — fast path)
# Get a key at https://aistudio.google.com/apikey then save it in the UI
# (Settings → LLM → Google Gemini) or seed it here for headless runs.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro
# LLM_DEFAULT_PROVIDER=gemini

# Option D — Google Vertex AI (Gemini Enterprise surface on Google Cloud)
# Production / Cloud Run path. No API key needed when running on Cloud Run with a
# service account that has the "Vertex AI User" role on the project — ADC works
# automatically. Off-GCP, point GOOGLE_APPLICATION_CREDENTIALS at a service
# account JSON or paste it into the UI (Settings → LLM → Vertex AI).
# GOOGLE_CLOUD_PROJECT=kletron
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# VERTEX_MODEL=gemini-2.5-pro
# LLM_DEFAULT_PROVIDER=vertex

# MCP — bundled tool server (must match apps/mcp-server when running dev stack)
MCP_URL=http://localhost:9000/sse

# Shared secret between Next.js API and MCP server (same value in all processes)
MCP_INTERNAL_TOKEN=change-me-long-random-token

# Where MCP server calls back into the web app
KLETRON_WEB_BASE_URL=http://127.0.0.1:3000

# LangGraph dev / deployment (set if you use hosted LangGraph; optional for basic local dev)
LANGGRAPH_API_KEY=

# -----------------------------------------------------------------------------
# TELEGRAM (Messenger channel — POST /api/webhooks/channels/telegram)
# -----------------------------------------------------------------------------
# GCP prod (project kletron): python3 infra/gcp/provision_secrets.py pushes optional
# CHANNEL_TELEGRAM_BOT_TOKEN / CHANNEL_TELEGRAM_WEBHOOK_SECRET / KLETRON_CHANNEL_SECRETS_KEY
# to Secret Manager and binds Cloud Run kletron-web. Then ./infra/gcp/set-telegram-webhook.sh
#
# Bot token: save via UI (Configuration → Messenger channels) OR set:
# CHANNEL_TELEGRAM_BOT_TOKEN=
# Optional webhook verification — must match Telegram setWebhook "secret_token"
# (sent as header X-Telegram-Bot-Api-Secret-Token):
# CHANNEL_TELEGRAM_WEBHOOK_SECRET=
# Encrypt tokens stored from the UI (32+ byte secret):
# KLETRON_CHANNEL_SECRETS_KEY=
# Thread tool policy for NEW Telegram agent runs (confirm_everything | full_auto_thread | inherit).
# Default full_auto_thread so read-only tools execute; strict: confirm_everything
# CHANNEL_TELEGRAM_THREAD_APPROVAL_MODE=full_auto_thread
# Job queue: omit or mongodb (default) persists jobs in MongoDB for multi-instance drains.
# Single-process dev-only shortcut (no DB queue row):
# CHANNEL_TELEGRAM_QUEUE_BACKEND=memory
# Legacy single-workspace env shortcut (prefer UI link + workspace channel settings):
# CHANNEL_TELEGRAM_WORKSPACE_ID=
# CHANNEL_TELEGRAM_GRAPH_ID=

# -----------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# -----------------------------------------------------------------------------

# GitHub (repo picker, private clones)
GITHUB_TOKEN=
KLETRON_REPOS_DIR=

# Connector OAuth (enable only what you need)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Cloud Console — same project as this OAuth client id:
#   - Gmail API (gmail.googleapis.com)
#   - Gmail MCP API (gmailmcp.googleapis.com) — Codex hosted Gmail MCP; OAuth consent must include gmail.compose + gmail.readonly per Google docs
#   - Google Calendar API — Calendar connector / curated Codex calendar tools
#   - Google Drive API — Drive connector
# Kletron web/Electron uses CODEX_HOME under ~/.kletron/codex/<hash>; ~/.codex is only for standalone Codex CLI.
# Local dev: if .env has NEXTAUTH_URL / NEXT_PUBLIC_APP_URL = https://www.kletron.com, connecteurs OAuth
# will use that host for redirect_uri. For http://localhost:3000, use root env.local.example → .env.local
# (override) and add http://localhost:3000 + /api/auth/connect/{gmail,google-calendar,google-drive}/callback
# in Google Cloud Console. Debug scopes in server logs: KLETRON_DEBUG_GOOGLE_TOKEN_SCOPES=1 (see env.local.example).
# Debug: log Gmail OAuth scope list via tokeninfo (server logs only; scopes are not secrets)
# KLETRON_DEBUG_GOOGLE_TOKEN_SCOPES=1

# Optional web search
TAVILY_API_KEY=

# Agent / graph tuning
GRAPH_RECURSION_LIMIT=50
TOOL_RESULT_EVICT_CHARS=80000
TOOL_RESULT_PREVIEW_CHARS=2000

# OpenAI Codex CLI — required on the server host so Kletron can spawn the Codex bridge (Settings → LLM → Codex).
# `npm install` at repo root exposes `<repo>/node_modules/.bin/codex`. Override if needed:
# KLETRON_CODEX_BINARY=/usr/local/bin/codex
# KLETRON_CODEX_BACKEND_DISABLED=1
# When Gmail is connected, Kletron syncs Codex config with features.apps=false + enable_mcp_apps=false and clears codex_apps_tools cache (set to 1 to keep ChatGPT Apps MCP / cache):
# KLETRON_CODEX_KEEP_APPS_MCP=1
#
# Codex + Gmail/Calendar/Drive (default): Kletron exposes Streamable HTTP MCP at
#   `{KLETRON_LOCAL_MCP_BASE_URL}/api/mcp/workspace/<workspaceId>`
# using the same REST tools as LangGraph. Codex receives `KLETRON_LOCAL_MCP_AUTH` (Bearer token
# signed with KLETRON_ENCRYPTION_KEY — same key material as connector encryption).
# KLETRON_LOCAL_MCP_BASE_URL=http://127.0.0.1:3000
#
# Opt-in: Google hosted Gmail MCP preview (gmailmcp.googleapis.com) — requires Workspace Developer Preview enrollment:
# KLETRON_CODEX_USE_HOSTED_GMAIL_MCP=1

# CORS for /api/* (comma-separated origins, or leave empty for localhost defaults in dev)
KLETRON_CORS_ALLOWLIST=

# -----------------------------------------------------------------------------
# PRODUCTION / HARDENING
# -----------------------------------------------------------------------------

# Credential encryption at rest (32-byte hex or base64). Set in prod.
# Also used to HMAC-sign short-lived local Codex MCP bearer tokens (see KLETRON_LOCAL_MCP_* above).
KLETRON_ENCRYPTION_KEY=

# MongoDB auth (if not in connection string)
# MONGODB_USER=
# MONGODB_PASS=
