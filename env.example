# =============================================================================
# Kletron — environment template
# =============================================================================
# Quick path:
#   cp env.example .env
#   Fill **MINIMUM TO START** (Mongo + one LLM path + secrets below)
#   docker compose up -d mongo
#   npm install && npm run seed:demo && npm run dev
#
# Docs: README.md, CONTRIBUTING.md, ARCHITECTURE.md
# =============================================================================

# -----------------------------------------------------------------------------
# MINIMUM TO START (local dev)
# -----------------------------------------------------------------------------

# MongoDB — use docker compose (see docker-compose.yml) or your own instance
MONGODB_URI=mongodb://localhost:27017/kletron

# NextAuth — required for the web app (generate a long random string)
NEXTAUTH_SECRET=change-this-to-a-long-random-secret-for-local-dev

# Public origin of the web app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Trust X-Forwarded-* behind reverse proxies (Cloud Run, nginx, etc.)
AUTH_TRUST_HOST=true

# --- Pick ONE default LLM path for agents (BYOK / local) ----------------------

# Option A — Local LM Studio / Ollama (recommended for $0 quickstart)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=your-local-model-name
LMSTUDIO_API_KEY=lm-studio
LLM_DEFAULT_PROVIDER=lmstudio

# Option B — Azure OpenAI (uncomment and fill; set LLM_DEFAULT_PROVIDER=azure)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# AZURE_OPENAI_MODEL=gpt-5-mini
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# LLM_DEFAULT_PROVIDER=azure

# MCP — bundled tool server (must match apps/mcp-server when running dev stack)
MCP_URL=http://localhost:9000/sse

# Shared secret between Next.js API and MCP server (same value in all processes)
MCP_INTERNAL_TOKEN=change-me-long-random-token

# Where MCP server calls back into the web app
KLETRON_WEB_BASE_URL=http://127.0.0.1:3000

# LangGraph dev / deployment (set if you use hosted LangGraph; optional for basic local dev)
LANGGRAPH_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# -----------------------------------------------------------------------------

# GitHub (repo picker, private clones)
GITHUB_TOKEN=
KLETRON_REPOS_DIR=

# Connector OAuth (enable only what you need)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional web search
TAVILY_API_KEY=

# Agent / graph tuning
GRAPH_RECURSION_LIMIT=50
TOOL_RESULT_EVICT_CHARS=80000
TOOL_RESULT_PREVIEW_CHARS=2000

# CORS for /api/* (comma-separated origins, or leave empty for localhost defaults in dev)
KLETRON_CORS_ALLOWLIST=

# -----------------------------------------------------------------------------
# PRODUCTION / HARDENING
# -----------------------------------------------------------------------------

# Credential encryption at rest (32-byte hex or base64). Set in prod.
KLETRON_ENCRYPTION_KEY=

# MongoDB auth (if not in connection string)
# MONGODB_USER=
# MONGODB_PASS=
