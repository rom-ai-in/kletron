{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Web App",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "apps/web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "MCP Server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/mcp-server/server.js", "--mcp"],
      "port": 9000
    },
    {
      "name": "LangGraph Dev Server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["@langchain/langgraph-cli", "dev", "--port", "8080", "--no-browser", "--config", "langgraph.json"],
      "port": 8080
    },
    {
      "name": "Desktop App (Electron)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "apps/desktop", "run", "dev"],
      "port": 5173
    },
    {
      "name": "UI Package (watch)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "packages/ui", "run", "dev"],
      "port": 0
    },

    {
      "name": "Terminal Worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "watch", "scripts/terminal-worker.ts"],
      "port": 3002
    }
  ]
}
