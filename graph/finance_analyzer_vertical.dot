digraph FinanceAnalyzer {
    rankdir=TB;
    node [shape=box, style=rounded, fontname=Arial, fontsize=11];
    edge [fontname=Arial, fontsize=9, arrowsize=0.8];
    graph [dpi=300, bgcolor=white];

    "__end__" [label="END", fillcolor="lightgray", style="rounded,filled"];
    "__start__" [label="START", fillcolor="lightgray", style="rounded,filled"];
    "anomaly_detection" [label="Anomaly
Detection", fillcolor="#FF6B6B", style="rounded,filled"];
    "data_processing" [label="Data Processing
Subgraph
(Load→Clean→Analyze)", fillcolor="#9370DB", style="rounded,filled"];
    "data_quality" [label="Data Quality
Agent", fillcolor="#4A90E2", style="rounded,filled"];
    "forecasting" [label="Forecasting
Agent", fillcolor="#FF6B6B", style="rounded,filled"];
    "insights" [label="Generate
Insights", fillcolor="#9B59B6", style="rounded,filled"];
    "report_generator" [label="Report
Generator", fillcolor="#20B2AA", style="rounded,filled"];
    "risk_analysis" [label="Risk Analysis
Agent", fillcolor="#FF8C00", style="rounded,filled"];
    "supervisor" [label="Supervisor
Agent
(handles chat)", fillcolor="#FF1493", style="rounded,filled"];
    "visualization" [label="Visualization
Agent", fillcolor="#FFD700", style="rounded,filled"];

    "__start__" -> "supervisor" [style=dashed, label="entry"];
    "supervisor" -> "data_quality" [style=dashed, label="if needed"];
    "supervisor" -> "data_processing" [style=dashed, label="process data"];
    "supervisor" -> "insights" [style=dashed, label="if needed"];
    "supervisor" -> "visualization" [style=dashed, label="if requested"];
    "supervisor" -> "forecasting" [style=dashed, label="if requested"];
    "supervisor" -> "anomaly_detection" [style=dashed, label="if requested"];
    "supervisor" -> "risk_analysis" [style=dashed, label="if requested"];
    "supervisor" -> "report_generator" [style=dashed, label="if requested"];
    "supervisor" -> "__end__" [style=solid, label="handles chat"];
    "data_quality" -> "supervisor" [style=dotted, label="done"];
    "data_processing" -> "supervisor" [style=dotted, label="done"];
    "insights" -> "supervisor" [style=dotted, label="done"];
    "visualization" -> "supervisor" [style=dotted, label="done"];
    "forecasting" -> "supervisor" [style=dotted, label="done"];
    "anomaly_detection" -> "supervisor" [style=dotted, label="done"];
    "risk_analysis" -> "supervisor" [style=dotted, label="done"];
    "report_generator" -> "supervisor" [style=dotted, label="done"];
    // Note: data_processing is a subgraph containing: load_inspect → clean_normalize → analyze
}