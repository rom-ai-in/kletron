diff --git a/hermes_cli/kletron_identity.py b/hermes_cli/kletron_identity.py
new file mode 100644
index 000000000..464e97a53
--- /dev/null
+++ b/hermes_cli/kletron_identity.py
@@ -0,0 +1,11 @@
+"""Kletron product identity (Python side): the desktop application id.
+
+Kletron is a distribution of Hermes Agent by Nous Research (MIT, see LICENSE / NOTICE).
+Module names, ``HERMES_*`` variables, ``~/.hermes`` paths and the ``hermes`` command are deliberately
+unchanged; ``kletron`` is an alias entry point. Displayed strings ("Hermes" -> "Kletron") are NOT
+patched: they are rewritten at build time in a throw-away copy of the tree (kletron/build/rebrand,
+VSCodium/Cursor model, docs/06-STRATEGIE-FORK-AMONT.md).
+"""
+
+# Must equal apps/desktop/product-identity.cjs appId (upstream test_linux_desktop_entry checks it).
+APP_ID = "ch.numezis.kletron"
diff --git a/hermes_cli/linux_desktop_entry.py b/hermes_cli/linux_desktop_entry.py
index c6bcc0300..af09e300b 100644
--- a/hermes_cli/linux_desktop_entry.py
+++ b/hermes_cli/linux_desktop_entry.py
@@ -27,7 +27,7 @@ from typing import Callable, Mapping, Optional
 # verbatim (Wayland app_id, CHROME_DESKTOP). GNOME links a window to a launcher by StartupWMClass
 # or by a `<app_id>.desktop` file name, so the entry has to carry the same id — under the old
 # "hermes.desktop" name a packaged launch matches neither rung and lands on the placeholder icon.
-APP_ID = "com.nousresearch.hermes"
+from hermes_cli.kletron_identity import APP_ID  # Kletron: mirrors product-identity.cjs appId
 DESKTOP_ENTRY_NAME = f"{APP_ID}.desktop"
 
 # Entry name written before the app-id rename; a successful install converts it into a hidden
diff --git a/pyproject.toml b/pyproject.toml
index 3f1155f35..9188577aa 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -585,6 +585,7 @@ build-backend = "setuptools.build_meta"
 
 [project.scripts]
 hermes = "hermes_cli.main:main"
+kletron = "hermes_cli.main:main"
 hermes-agent = "agent.legacy_cli:main"
 hermes-acp = "acp_adapter.entry:main"
 
