# Kletron platform — local demo only. No real secrets.
KLETRON_CLIENT_ID=demo-client
KLETRON_ENV=local-demo

# Console
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=7100

# MCP gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=7101
GATEWAY_INTERNAL_TOKEN=demo-gateway-internal-not-a-secret

# LiteLLM → EveryWare (demo placeholders — never real keys)
LITELLM_MASTER_KEY=sk-demo-master-not-real
LITELLM_PORT=4000
EVERYWARE_API_BASE=https://everyware.example.invalid/v1
EVERYWARE_API_KEY=sk-everyware-demo-not-real
EVERYWARE_MODEL=everyware-demo-small

# OpenShell harness
OPENSHELL_MODE=deny-by-default
OPENSHELL_ALLOWLIST=127.0.0.1:7100,127.0.0.1:7101

# Paths
KLETRON_DATA_DIR=./data/runtime
KLETRON_POLICY_FILE=./config/demo-policy.json
