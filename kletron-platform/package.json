{
  "name": "kletron-platform",
  "version": "0.1.0-demo",
  "private": true,
  "description": "Kletron platform local demo — MCP gateway, Console, LiteLLM config, OpenShell harness, mock connectors",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/demo/main.ts",
    "prove": "bash scripts/prove.sh",
    "litellm:config": "tsx src/litellm/cli.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
