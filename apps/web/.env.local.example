# Copy to `.env.local` in this directory (Next.js loads it; file is gitignored).
# Use when you run: npm run dev:web  (or `next dev` from apps/web) and need local OAuth.
#
# NEXT_PUBLIC_APP_URL and NEXTAUTH_URL must point at the same origin you use in the browser
# (e.g. http://localhost:3000) or getPublicAppOrigin() will build OAuth redirect_uri to prod
# and Google will send the callback to the wrong host.
#
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Server logs: OAuth scope list via tokeninfo (no secrets; set on server only)
KLETRON_DEBUG_GOOGLE_TOKEN_SCOPES=1
