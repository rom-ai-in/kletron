# Copy to `.env.local` in the **repository root** (gitignored).
# `scripts/lib/serviceLauncher.ts` loads `.env` first, then `.env.local` with override — so you can
# keep production URLs in `.env` and override only for local machine testing.
#
# Required for Google connecteurs (Gmail/Calendar/Drive) when you open the app at
# http://localhost:3000 but your `.env` still has https://www.kletron.com — otherwise OAuth
# `redirect_uri` points at prod and the callback never hits your local Next.js server.
#
# Also add these origins + redirect URIs in Google Cloud Console → OAuth client (Web).
#
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
KLETRON_DEBUG_GOOGLE_TOKEN_SCOPES=1
