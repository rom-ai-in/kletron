{
  "name": "numezis.code",
  "displayName": "Numezis Code",
  "description": "VS Code extension for the Numezis agent platform.",
  "version": "0.1.0",
  "icon": "resources/icon.svg",
  "engines": {
    "vscode": ">=1.80.0"
  },
  "activationEvents": [
    "onView:numezis.chatView"
  ],
  "main": "out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "compile": "tsc -p ./tsconfig.json",
    "build:webview": "node scripts/build-webview.js",
    "watch:webview": "node scripts/build-webview.js --watch",
    "package": "vsce package"
  },
  "contributes": {
    "commands": [
      {
        "command": "numezis.login",
        "title": "Numezis: Sign In"
      },
      {
        "command": "numezis.logout",
        "title": "Numezis: Sign Out"
      },
      {
        "command": "numezis.validateToken",
        "title": "Numezis: Validate Token"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Numezis Extension",
      "properties": {
        "numezis.backendUrl": {
          "type": "string",
          "description": "Base URL for the Numezis backend.",
          "default": "http://localhost:3000"
        },
        "numezis.apiToken": {
          "type": "string",
          "description": "API token for authenticated requests (generate from your Numezis Code account).",
          "default": ""
        },
        "numezis.llm.provider": {
          "type": "string",
          "description": "LLM provider identifier (ex: openai, ollama, anthropic).",
          "default": "openai"
        },
        "numezis.llm.baseUrl": {
          "type": "string",
          "description": "Base URL for the LLM provider (optional).",
          "default": ""
        },
        "numezis.llm.model": {
          "type": "string",
          "description": "Default LLM model name.",
          "default": "gpt-4o-mini"
        },
        "numezis.llm.apiKey": {
          "type": "string",
          "description": "API key for the LLM provider (optional).",
          "default": ""
        },
        "numezis.llm.temperature": {
          "type": "number",
          "description": "Default LLM temperature.",
          "default": 0.2
        },
        "numezis.llm.maxTokens": {
          "type": "number",
          "description": "Default LLM max tokens (optional).",
          "default": 0
        },
        "numezis.defaultGraphId": {
          "type": "string",
          "description": "Default agent graph id.",
          "default": ""
        },
        "numezis.inline.enabled": {
          "type": "boolean",
          "description": "Enable inline suggestions in the editor.",
          "default": false
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "numezis",
          "title": "Numezis",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "numezis": [
        {
          "id": "numezis.chatView",
          "name": "Code",
          "type": "webview"
        }
      ]
    }
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.19.0",
    "typescript": "4.9.5",
    "vsce": "^2.10.0"
  }
}