{
  "extends": "./tsconfig.base.json",
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "langgraph.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__",
    "apps/web/.next",
    "vendor",
    "apps/mcp-server/**",
    "apps/vscode-extension/**",
    "apps/web/node_modules",
    "packages/**/node_modules"
  ]
}
