{
  "extends": "./tsconfig.base.json",
  "include": [
    "apps/cli/src/**/*.ts",
    "apps/desktop/electron/**/*.ts",
    "apps/desktop/src/**/*.ts",
    "apps/desktop/src/**/*.d.ts",
    "apps/desktop/src/**/*.tsx",
    "apps/web/app/**/*.ts",
    "apps/web/app/**/*.tsx",
    "apps/web/components/**/*.ts",
    "apps/web/components/**/*.tsx",
    "apps/web/context/**/*.ts",
    "apps/web/context/**/*.tsx",
    "apps/web/hooks/**/*.ts",
    "apps/web/hooks/**/*.tsx",
    "apps/web/lib/**/*.ts",
    "apps/web/pages/**/*.ts",
    "apps/web/pages/**/*.tsx",
    "packages/agent-core/src/**/*.ts",
    "packages/bridge/src/**/*.ts",
    "packages/codex-bridge/src/**/*.ts",
    "packages/mcp-client/src/**/*.ts",
    "packages/server/src/**/*.ts",
    "packages/shared/src/**/*.ts",
    "packages/ui/src/**/*.ts",
    "packages/ui/src/**/*.tsx",
    "scripts/check-context.ts",
    "vitest.config.ts",
    "langgraph.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/.next/**",
    "**/node_modules/**",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "vendor",
    "apps/mcp-server/**",
    "apps/server/**",
    "apps/desktop/dist/**",
    "apps/desktop/dist-electron/**",
    "apps/desktop/build/**",
    "apps/desktop/src/iconManager.ts",
    "apps/desktop/src/statusBar.ts",
    "apps/desktop/src/protocol.ts",
    "apps/desktop/src/native/notifications.ts",
    "apps/desktop/src/ipc/categoryHandlers.ts",
    "packages/ui/src/components/ba/**",
    "packages/ui/src/components/drift/**",
    "packages/ui/src/components/config/BAConfigView.tsx"
  ]
}
