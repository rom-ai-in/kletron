{
  "name": "kletron",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP-native agent graphs with a real UI. Local-first / BYOK — run models on your keys or on your machine.",
  "license": "MIT",
  "author": "Romain Magnin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rom-ai-in/kletron.git"
  },
  "homepage": "https://github.com/rom-ai-in/kletron#readme",
  "bugs": {
    "url": "https://github.com/rom-ai-in/kletron/issues"
  },
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper 2>/dev/null || true",
    "dev:infra": "docker compose up -d mongo",
    "seed:demo": "tsx scripts/seed-demo-workspace.ts",
    "quickstart": "npm run dev:infra && npm install && npm run seed:demo && npm run dev",
    "start": "tsx scripts/start-all.ts",
    "dev": "tsx scripts/dev-all.ts",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:desktop": "npm --workspace apps/desktop run dev",
    "worker:i18n-process": "tsx scripts/i18n-process-worker.ts",
    "migrate:workspaces-owner": "tsx scripts/migrate-workspaces-owner.ts",
    "migrate:connectors-account": "tsx scripts/migrate-connectors-account-model.ts",
    "seed:builtin-skills": "tsx scripts/seed-builtin-skills.ts",
    "check:context": "tsx scripts/check-context.ts",
    "build:ui": "npm --workspace packages/ui run build",
    "build": "npm run build:ui && npm run check:context && npm --workspace apps/web run build",
    "build:web": "npm run build:ui && npm run check:context && npm --workspace apps/web run build",
    "build:desktop": "npm run build:ui && npm --workspace apps/desktop run build",
    "dist:desktop": "npm run build:desktop && npm --workspace apps/desktop run dist:mac",
    "start:web": "npm --workspace apps/web run start",
    "start:desktop": "npm --workspace apps/desktop run start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test": "npm run typecheck && npm run test:unit",
    "seed:skills": "tsx scripts/seed-builtin-skills.ts",
    "seed:canonical": "tsx scripts/seed-canonical-db.ts",
    "seed:all-workspaces": "tsx scripts/seed-all-workspaces.ts",
    "dev:adk": "tsx apps/mcp-server/adk-entrypoint.ts",
    "start:adk": "tsx apps/mcp-server/adk-entrypoint.ts"
  },
  "dependencies": {
    "@cyntler/react-doc-viewer": "^1.14.1",
    "@google/adk": "^1.1.0",
    "@langchain/anthropic": "^1.3.13",
    "@langchain/core": "1.1.48",
    "@langchain/google-genai": "^2.1.14",
    "@langchain/google-vertexai": "^2.1.31",
    "@langchain/langgraph": "^1.1.0",
    "@langchain/langgraph-checkpoint-mongodb": "^1.1.7",
    "@langchain/ollama": "^1.2.2",
    "@langchain/openai": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/chokidar": "^1.7.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.1",
    "@types/xterm": "^2.0.3",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.15",
    "chokidar": "^5.0.0",
    "cross-fetch": "^3.1.8",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.4.7",
    "electron": "41.1.0",
    "electron-builder": "26.8.1",
    "esbuild": "0.27.4",
    "eventsource": "^4.0.0",
    "glob": "^13.0.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.1.3",
    "langchain": "1.2.16",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "monaco-editor": "^0.53.0",
    "mongodb": "^7.0.0",
    "next": "^14.2.7",
    "next-auth": "^4.24.14",
    "node-pty": "^1.1.0",
    "officeparser": "^6.0.4",
    "postcss": "^8.4.40",
    "pptx-automizer": "^0.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.30.0",
    "stripe": "^17.7.0",
    "tailwindcss": "^3.4.4",
    "ws": "^8.19.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.1.11",
    "@openai/codex": "^0.128.0",
    "@types/mongodb": "^4.0.6",
    "@types/node": "^20.6.0",
    "@types/react": "^18.2.35",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.3.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.6.0",
    "vite": "6.4.2",
    "vitest": "2.1.9"
  },
  "overrides": {
    "vitest": "2.1.9",
    "@vitest/coverage-v8": "2.1.9"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
