{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@numezis/shared": ["packages/shared/src/index.ts"],
      "@numezis/shared/*": ["packages/shared/src/*"],
      "@numezis/ui": ["packages/ui/src/index.ts"],
      "@numezis/ui/*": ["packages/ui/src/*"],
      "@numezis/server": ["packages/server/src/index.ts"],
      "@numezis/server/*": ["packages/server/src/*"],
      "@numezis/agent-core": ["packages/agent-core/src/index.ts"],
      "@numezis/agent-core/*": ["packages/agent-core/src/*"],
      "@numezis/mcp-client": ["packages/mcp-client/src/index.ts"],
      "@numezis/mcp-client/*": ["packages/mcp-client/src/*"],
      "@numezis/bridge": ["packages/bridge/src/index.ts"],
      "@numezis/bridge/*": ["packages/bridge/src/*"]
    }
  }
}
